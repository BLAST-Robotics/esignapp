# Storage engine: 'json', 'sqlite', or 'postgres' (auto-detected if not set)
# STORAGE_ENGINE=json

# Postgres connection string (any of these env var names are auto-detected)
# POSTGRES_URL, STORAGE_URL, DATABASE_URL, DATABASE_URL_UNPOOLED,
# NEON_DATABASE_URL, NEON_DATABASE_URL_UNPOOLED, PRISMA_POSTGRES_URL
# POSTGRES_URL=postgres://user:password@host:5432/database

# Admin panel password (for dev override, any email + this password logs in)
# ADMIN_PASSWORD=admin

# Seed admin credentials (omit to skip seeding)
# SEED_ADMIN_EMAIL=hello@example.org
# SEED_ADMIN_PASSWORD=change_this_in_production
